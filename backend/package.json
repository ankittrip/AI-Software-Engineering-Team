{
  "name": "ai-software-engineering-team",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
  "dev:api": "npm run dev --workspace=apps/api",
  "dev:worker": "npm run dev --workspace=apps/worker",
  "dev": "concurrently \"npm run dev:api\" \"npm run dev:worker\"",

  "start:api": "node apps/api/index.js",
  "start:worker": "node apps/worker/index.js"
},
  "devDependencies": {
    "concurrently": "^8.2.0",
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@upstash/redis": "^1.38.0",
    "bullmq": "^5.77.6",
    "ioredis": "^5.11.0",
    "octokit": "^5.0.5"
  }
}
